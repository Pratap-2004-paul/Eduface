# ══════════════════════════════════════════════
#  Smart Attendance System — .gitignore
#  Files and folders that should NOT go to GitHub
# ══════════════════════════════════════════════


# ── Python virtual environment ─────────────────
# This folder is huge (500MB+). Anyone who clones
# your project will create their own venv.
venv/
env/
.env/
.venv/


# ── Python cache files ──────────────────────────
# Auto-generated by Python. Not needed on GitHub.
__pycache__/
*.pyc
*.pyo
*.pyd
.Python


# ── Database file ───────────────────────────────
# Contains real student/teacher data.
# Never upload real user data to GitHub.
attendance.db
*.db
*.sqlite
*.sqlite3


# ── Face encoding data ───────────────────────────
# Contains biometric face data of real people.
# Must never be uploaded to GitHub.
face_encodings_data/
*.pkl


# ── Student face photos ──────────────────────────
# Real photos of students.
# Private biometric data — never upload.
student_faces/


# ── Environment variables file ───────────────────
# If you ever store secret keys in .env file.
.env
.env.local
.env.production


# ── VS Code settings ─────────────────────────────
# Your personal editor settings.
# Not needed by others.
.vscode/
*.code-workspace


# ── OS generated files ────────────────────────────
# Windows
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Mac
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~


# ── Logs ─────────────────────────────────────────
*.log
logs/
pip-log.txt


# ── Test files ────────────────────────────────────
# Temporary test scripts we created
test_db.py
add_departments.py


# ── Uploaded files (if any) ──────────────────────
uploads/
temp/
tmp/


# ── Distribution / build ─────────────────────────
dist/
build/
*.egg-info/
*.egg


# ── Pytest cache ─────────────────────────────────
.pytest_cache/
.coverage
htmlcov/


# ── Jupyter notebooks (if any) ───────────────────
.ipynb_checkpoints/


# ── Certificate files ─────────────────────────────
*.pem
*.key
*.crt